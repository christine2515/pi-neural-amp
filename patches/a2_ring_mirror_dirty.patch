 //   end of history, memmove the trailing max_lookback cols back to offset 0
 //   and reset write_pos. That memmove is the jitter spike we're measuring.
 // -----------------------------------------------------------------------------
+// Mode 1 invariant: columns [pow2, pow2 + mbs) are a copy of columns [0, mbs).
+// Instead of re-copying all mbs columns every block, copy only the columns this
+// block wrote that fall inside [0, mbs): the part of [wp, wp + first) below mbs,
+// plus the wrapped part [0, num_frames - first). Same bytes in the buffer after
+// every block, so the output is unchanged. A layer's write lands in [0, mbs)
+// once per pow2_size / num_frames blocks, so at block 128 the A2 stack copies
+// about 36% of the old volume on average (short-lookback layers, pow2 = 256,
+// still mirror every other block).
 template <int Channels>
+void A2FastModel<Channels>::_mirror_dirty(float* hist, int pow2_size, int mbs, int wp, int first, int num_frames)
+{
+  if (wp < mbs)
+  {
+    const int end = std::min(wp + first, mbs);
+    std::memcpy(hist + static_cast<size_t>(pow2_size + wp) * Channels, hist + static_cast<size_t>(wp) * Channels,
+                static_cast<size_t>(end - wp) * Channels * sizeof(float));
+  }
+  if (first < num_frames)
+  {
+    std::memcpy(hist + static_cast<size_t>(pow2_size) * Channels, hist,
+                static_cast<size_t>(num_frames - first) * Channels * sizeof(float));
+  }
+}
