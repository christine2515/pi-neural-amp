+  #if NAM_A2_LITE_NEON
+// =============================================================================
+// A2-Lite (3 channels) NEON kernel: output channels in lanes, 4 frames per tile.
+//
+// acc[t] holds frame t's 3 conv outputs in lanes 0-2 (lane 3 = 0 padding), and
+// stays in a q-register across all K taps (no z buffer). Per tap the 3 padded
+// weight columns (3 q) are loaded once and shared by the 4 frames, and the 4
+// frames' inputs are 12 contiguous floats (3 q, no vld3 de-interleave). Each
+// input value is used as a d-register lane by VMLA.F32 Qd, Qn, Dm[x].
+// 4 acc + 3 W + 3 x = 10 q-registers. Per tap: 6 loads + 12 VMLA.
+//
+// Arithmetic order per output is the same as the scalar kernel (bias first,
+// then for each tap input channels 0, 1, 2; then mixin, LeakyReLU, head sum,
+// and lin += ((b + L0*a0) + L1*a1) + L2*a2), and VMLA is not fused, so the
+// result should match the scalar code except where ARMv7 NEON flushes
+// denormals to zero.
+// =============================================================================
+__attribute__((always_inline)) inline void a2_lite_fence(float32x4_t& a, float32x4_t& b, float32x4_t& c,
+                                                         float32x4_t& d)
+{
+  asm volatile("" : "+w"(a), "+w"(b), "+w"(c), "+w"(d));
+}
+
+// [a0 a1 a2 _][b0 b1 b2 _][c0 c1 c2 _][d0 d1 d2 _] -> 12 packed floats as 3 q.
+__attribute__((always_inline)) inline void a2_lite_pack(const float32x4_t (&v)[4], float32x4_t (&o)[3])
+{
+  const float32x2_t l0 = vget_low_f32(v[0]), h0 = vget_high_f32(v[0]);
+  const float32x2_t l1 = vget_low_f32(v[1]), h1 = vget_high_f32(v[1]);
+  const float32x2_t l2 = vget_low_f32(v[2]), h2 = vget_high_f32(v[2]);
+  const float32x2_t l3 = vget_low_f32(v[3]), h3 = vget_high_f32(v[3]);
+  o[0] = vcombine_f32(l0, vzip_f32(h0, l1).val[0]); // a0 a1 a2 b0
+  o[1] = vcombine_f32(vext_f32(l1, h1, 1), l2); //     b1 b2 c0 c1
+  o[2] = vcombine_f32(vzip_f32(h2, l3).val[0], vext_f32(l3, h3, 1)); // c2 d0 d1 d2
+}
+
+template <int K>
+NAM_A2_LITE_KERNEL void a2_lite_tile4(const float* const* __restrict taps, const float* __restrict w4,
+                                      const float* __restrict b4, const float* __restrict m4,
+                                      const float* __restrict l4, const float* __restrict lb4,
+                                      const float* __restrict cond, float* __restrict hsum,
+                                      float* __restrict lin, float leaky_slope)
+{
+  const float32x4_t bias = vld1q_f32(b4);
+  float32x4_t a0 = bias, a1 = bias, a2 = bias, a3 = bias;
+  #if defined(__clang__)
+    #pragma clang loop unroll(disable)
+  #endif
+  for (int k = 0; k < K; k++)
+  {
+    const float* w = w4 + k * 12;
+    const float32x4_t c0 = vld1q_f32(w), c1 = vld1q_f32(w + 4), c2 = vld1q_f32(w + 8);
+    const float* x = taps[k];
+    const float32x4_t x0 = vld1q_f32(x), x1 = vld1q_f32(x + 4), x2 = vld1q_f32(x + 8);
+    const float32x2_t d0 = vget_low_f32(x0), d1 = vget_high_f32(x0);
+    const float32x2_t d2 = vget_low_f32(x1), d3 = vget_high_f32(x1);
+    const float32x2_t d4 = vget_low_f32(x2), d5 = vget_high_f32(x2);
+    // frame:      0         1         2         3
+    // input 0:  d0[0]     d1[1]     d3[0]     d4[1]
+    // input 1:  d0[1]     d2[0]     d3[1]     d5[0]
+    // input 2:  d1[0]     d2[1]     d4[0]     d5[1]
+    a0 = vmlaq_lane_f32(a0, c0, d0, 0);
+    a1 = vmlaq_lane_f32(a1, c0, d1, 1);
+    a2 = vmlaq_lane_f32(a2, c0, d3, 0);
+    a3 = vmlaq_lane_f32(a3, c0, d4, 1);
+    a0 = vmlaq_lane_f32(a0, c1, d0, 1);
+    a1 = vmlaq_lane_f32(a1, c1, d2, 0);
+    a2 = vmlaq_lane_f32(a2, c1, d3, 1);
+    a3 = vmlaq_lane_f32(a3, c1, d5, 0);
+    a0 = vmlaq_lane_f32(a0, c2, d1, 0);
+    a1 = vmlaq_lane_f32(a1, c2, d2, 1);
+    a2 = vmlaq_lane_f32(a2, c2, d4, 0);
+    a3 = vmlaq_lane_f32(a3, c2, d5, 1);
+    a2_lite_fence(a0, a1, a2, a3);
+  }
+
+  // Mixin + LeakyReLU (slope < 1: max(x, slope * x) == (x >= 0 ? x : slope * x)).
+  const float32x4_t m = vld1q_f32(m4);
+  float32x4_t act[4] = {vmlaq_n_f32(a0, m, cond[0]), vmlaq_n_f32(a1, m, cond[1]), vmlaq_n_f32(a2, m, cond[2]),
+                        vmlaq_n_f32(a3, m, cond[3])};
+  for (int t = 0; t < 4; t++)
+    act[t] = vmaxq_f32(act[t], vmulq_n_f32(act[t], leaky_slope));
+
+  // Head sum.
+  float32x4_t packed[3];
+  a2_lite_pack(act, packed);
+  vst1q_f32(hsum, vaddq_f32(vld1q_f32(hsum), packed[0]));
+  vst1q_f32(hsum + 4, vaddq_f32(vld1q_f32(hsum + 4), packed[1]));
+  vst1q_f32(hsum + 8, vaddq_f32(vld1q_f32(hsum + 8), packed[2]));
+
+  // layer1x1 residual: lin += ((b + L0*a0) + L1*a1) + L2*a2.
+  const float32x4_t lw0 = vld1q_f32(l4), lw1 = vld1q_f32(l4 + 4), lw2 = vld1q_f32(l4 + 8);
+  const float32x4_t lb = vld1q_f32(lb4);
+  float32x4_t r[4];
+  for (int t = 0; t < 4; t++)
+  {
+    const float32x2_t lo = vget_low_f32(act[t]), hi = vget_high_f32(act[t]);
+    float32x4_t v = vmlaq_lane_f32(lb, lw0, lo, 0);
+    v = vmlaq_lane_f32(v, lw1, lo, 1);
+    r[t] = vmlaq_lane_f32(v, lw2, hi, 0);
+  }
+  a2_lite_pack(r, packed);
+  vst1q_f32(lin, vaddq_f32(vld1q_f32(lin), packed[0]));
+  vst1q_f32(lin + 4, vaddq_f32(vld1q_f32(lin + 4), packed[1]));
+  vst1q_f32(lin + 8, vaddq_f32(vld1q_f32(lin + 8), packed[2]));
+}
+  #endif // NAM_A2_LITE_NEON
