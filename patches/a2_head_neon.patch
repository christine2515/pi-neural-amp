+#if defined(__ARM_NEON) && !defined(__aarch64__)
+// Head dot product, length N (48 for Lite, 128 for Full; both multiples of 8). Two accumulators so
+// consecutive VMLAs don't wait on each other's 5-cycle latency (measured on the A7, iteration 7).
+template <int N>
+  #if defined(__clang__)
+__attribute__((noinline, target("no-slowfpvmlx")))
+  #else
+__attribute__((noinline))
+  #endif
+float a2_head_dot(const float* __restrict w, const float* __restrict x)
+{
+  static_assert(N % 8 == 0, "head length must be a multiple of 8");
+  float32x4_t a0 = vdupq_n_f32(0.0f), a1 = vdupq_n_f32(0.0f);
+  for (int i = 0; i < N; i += 8)
+  {
+    a0 = vmlaq_f32(a0, vld1q_f32(w + i), vld1q_f32(x + i));
+    a1 = vmlaq_f32(a1, vld1q_f32(w + i + 4), vld1q_f32(x + i + 4));
+  }
+  const float32x4_t a = vaddq_f32(a0, a1);
+  const float32x2_t s = vadd_f32(vget_low_f32(a), vget_high_f32(a));
+  return vget_lane_f32(vpadd_f32(s, s), 0);
+}
+#endif
 
