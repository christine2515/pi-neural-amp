+template <int Channels>
+void A2FastModel<Channels>::_worker_main(int cpu, int prio)
+{
+  #if defined(__linux__)
+  if (cpu >= 0)
+  {
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(cpu, &set);
+    pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
+  }
+  if (prio > 0)
+  {
+    sched_param sp{};
+    sp.sched_priority = prio;
+    pthread_setschedparam(pthread_self(), SCHED_FIFO, &sp);
+  }
+  #else
+  (void)cpu;
+  (void)prio;
+  #endif
+  unsigned seen = 0;
+  while (!_stop.load(std::memory_order_acquire))
+  {
+    const unsigned job = _job.load(std::memory_order_acquire);
+    if (job == seen)
+    {
+  #if defined(__arm__) || defined(__aarch64__)
+      asm volatile("yield");
+  #endif
+      continue;
+    }
+    seen = job;
+    tl_b = &_sets[_job_set];
+    _stage_b();
+    _done.store(job, std::memory_order_release);
+  }
+}
+
+template <int Channels>
+void A2FastModel<Channels>::process(NAM_SAMPLE** input, NAM_SAMPLE** output, int num_frames)
+{
+  if (num_frames > GetMaxBufferSize())
+    SetMaxBufferSize(num_frames);
+
+  const NAM_SAMPLE* in0 = input[0];
+  NAM_SAMPLE* out0 = output[0];
+
+  if (!_pipe_enabled || _in_prewarm)
+  {
+    tl_b = &_sets[0];
+    _stage_a(in0, num_frames);
+    _stage_b();
+    const float* head_out = tl_b->head_out.data();
+    for (int f = 0; f < num_frames; f++)
+      out0[f] = static_cast<NAM_SAMPLE>(head_out[f]);
+    return;
+  }
+
+  // Pipelined: hand block n-1's stage B to the worker, run block n's stage A here, then wait.
+  const int cur = static_cast<int>(_seq & 1u);
+  const bool had_prev = _have_prev;
+  unsigned job = 0;
+  if (had_prev)
+  {
+    _job_set = cur ^ 1;
+    job = _job.load(std::memory_order_relaxed) + 1;
+    _job.store(job, std::memory_order_release);
+  }
+  tl_b = &_sets[cur];
+  _stage_a(in0, num_frames);
+  if (had_prev)
+  {
+    while (_done.load(std::memory_order_acquire) != job)
+    {
+  #if defined(__arm__) || defined(__aarch64__)
+      asm volatile("yield");
+  #endif
+    }
+    const Bufs& prev = _sets[cur ^ 1];
+    const int n = std::min(prev.num_frames, num_frames);
+    for (int f = 0; f < n; f++)
+      out0[f] = static_cast<NAM_SAMPLE>(prev.head_out[f]);
+    for (int f = n; f < num_frames; f++)
+      out0[f] = 0;
+  }
+  else
+  {
+    for (int f = 0; f < num_frames; f++)
+      out0[f] = 0;
+  }
+  _have_prev = true;
+  _seq++;
+}
